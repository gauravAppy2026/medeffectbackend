PORT=3001
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/medeffects?retryWrites=true&w=majority
JWT_SECRET=your-strong-random-secret-here
JWT_REFRESH_SECRET=your-strong-random-refresh-secret-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS - comma-separated allowed origins
CORS_ORIGINS=https://medeffectweb.pages.dev

# Cloudflare R2
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_BUCKET=medeffects
S3_PUBLIC_URL=https://pub-XXXX.r2.dev

# HIPAA Security
SESSION_IDLE_TIMEOUT=900000
THROTTLE_TTL=60
THROTTLE_LIMIT=100
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
